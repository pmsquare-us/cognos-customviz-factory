# Per-client Cognos environment. Copy to .env.<client> at the repo root (gitignored), e.g.
#   cp cognos.env.example .env.acme
# Used by tools/deploy-viz.mjs (--env acme) and by the in-Cognos debug loop (tools/cognos-dev/README.md).
# Never commit a filled-in copy.

# Gateway URL up to and including /bi, no trailing slash.
#   e.g. https://cognos.example.com/ibmcognos/bi   or   https://ca.example.com/bi
COGNOS_URL=

# How a script logs in: sso | apikey | native
#   sso    — sign in by hand in the Playwright browser; uploads go through the Manage UI.
#   apikey — headless REST login with an API key (Cognos: Profile → My API keys).
#   native — headless REST login with a namespace user/password.
COGNOS_AUTH=sso

# apikey
COGNOS_API_KEY=

# native
COGNOS_NAMESPACE=
COGNOS_USERNAME=
COGNOS_PASSWORD=

# Custom-visual endpoints, as "<METHOD> <path relative to COGNOS_URL>"; {id} = package id.
# CA's public REST API has no custom-visual endpoint, so capture these once per CA version from a
# logged-in browser — tools/cognos-dev/README.md "Endpoint discovery". Leave UPDATE/LIST empty if
# the server only offers one upload call.
COGNOS_VIZ_UPLOAD=
COGNOS_VIZ_UPDATE=
COGNOS_VIZ_LIST=
# zip (raw application/zip body) | multipart (form upload); and the form field name for multipart.
COGNOS_VIZ_UPLOAD_FORMAT=zip
COGNOS_VIZ_UPLOAD_FIELD=file

# In-Cognos debug loop: the "CV Dev Harness" dashboard Claude opens (URL or path), filled in after
# it's created on first run.
COGNOS_HARNESS_DASHBOARD=
